{
  "name": "pkmchampions-calculator",
  "version": "2.0.0",
  "private": true,
  "description": "Pokemon Champions battle calculator and team analysis toolkit",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:standalone",
    "build:standalone": "node build.mjs",
    "build:public": "node scripts/build-public.mjs",
    "build:pages": "node scripts/build-public.mjs --ad-free",
    "build:preview": "node scripts/build-public.mjs --private-test",
    "sample:calculator": "node scripts/build-calculator-sample.mjs",
    "sample:calculator:browser": "npm run build:pages && npm run sample:calculator && node scripts/calculator-sample-browser.mjs --public --ad-free --require-browser",
    "pages:ready": "node scripts/public-readiness-check.mjs --ad-free",
    "preview:ready": "node scripts/public-readiness-check.mjs --private-test",
    "check": "node scripts/check.mjs",
    "html:structure": "node scripts/html-structure-check.mjs",
    "css:structure": "node scripts/css-structure-check.mjs",
    "css:cascade": "node scripts/css-cascade-check.mjs",
    "js:structure": "node scripts/js-structure-check.mjs",
    "ui:dropdowns": "node scripts/mobile-dropdown-contract.mjs",
    "ui:audit": "node scripts/ui-architecture-audit.mjs",
    "ui:browser": "node scripts/ui-remodel-final-browser.mjs",
    "ui:browser:public": "npm run build:public && node scripts/ui-remodel-final-browser.mjs --public",
    "ui:browser:pages": "npm run build:pages && node scripts/ui-remodel-final-browser.mjs --public --ad-free",
    "spa:hosting": "node scripts/spa-hosting-check.mjs",
    "public:ready": "node scripts/public-readiness-check.mjs",
    "data:validate": "node scripts/validate-data.mjs && node scripts/regulation-mc-golden.mjs",
    "dex:smoke": "node scripts/dex-ui-smoke.mjs && node scripts/dex-state.mjs",
    "dex:browser": "npm run build:pages && node scripts/dex-browser.mjs --public --ad-free --require-browser",
    "damage:golden": "node scripts/damage-golden.mjs",
    "reverse:golden": "node scripts/reverse-golden.mjs && node scripts/reverse-exchange-golden.mjs",
    "coverage:matrix": "node scripts/coverage-matrix.mjs",
    "coverage:check": "node scripts/coverage-matrix.mjs --check",
    "state:entry": "node scripts/entry-effects-state.mjs",
    "state:finetune": "node scripts/fine-tune-state.mjs",
    "finetune:browser": "npm run build:pages && node scripts/fine-tune-browser.mjs --public --ad-free --require-browser",
    "state:party": "node scripts/party-preset-state.mjs && npm run party:safety",
    "party:browser": "npm run build:pages && node scripts/party-remodel-browser.mjs --public --ad-free --require-browser",
    "state:matchup": "node scripts/matchup-state.mjs && node scripts/matchup-behavior.mjs",
    "matchup:browser": "npm run build:pages && node scripts/matchup-browser.mjs --public --ad-free --require-browser",
    "test": "npm run check && npm run build:standalone && npm run html:structure && npm run css:structure && npm run css:cascade && npm run js:structure && npm run ui:dropdowns && npm run spa:hosting && npm run build:public && npm run public:ready && npm run build:pages && npm run pages:ready && npm run data:validate && npm run coverage:check && npm run dex:smoke && npm run damage:golden && npm run power:golden && npm run calculator:golden && npm run client:golden && npm run reverse:golden && npm run reverse:policy && npm run state:entry && npm run state:finetune && npm run state:party && npm run state:matchup && npm run modules:golden",
    "sync-data": "node scripts/sync-ps-data.mjs",
    "sync-data:dry": "node scripts/sync-ps-data.mjs --dry-run",
    "fetch-ko": "node scripts/fetch-ko.mjs",
    "power:golden": "node scripts/power-policy-golden.mjs",
    "reverse:policy": "node scripts/reverse-policy-golden.mjs",
    "reverse:browser": "npm run build:pages && node scripts/reverse-exchange-browser.mjs --public --ad-free --require-browser",
    "power:audit": "node scripts/power-mechanics-audit.mjs",
    "calculator:golden": "node scripts/calculator-completion-golden.mjs && node scripts/move-power-golden.mjs",
    "calculator:browser": "npm run build:pages && node scripts/calculator-remodel-browser.mjs --public --ad-free --require-browser",
    "client:golden": "node scripts/client-performance-golden.mjs",
    "modules:golden": "node scripts/modules-golden.mjs",
    "modules:browser": "npm run build:pages && node scripts/modules-browser.mjs --public",
    "party:safety": "node scripts/party-storage-golden.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "ws": "^8.21.1",
    "esbuild": "0.28.2",
    "acorn": "8.18.0"
  }
}
